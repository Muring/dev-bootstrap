#!/usr/bin/env bash
set -euo pipefail
PDP_SKILL_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PDP_RUNTIME="${PDP_RUNTIME:-${XDG_CACHE_HOME:-$HOME/.cache}/shopify-pdp}"
PDP_ACTION="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi
case "$PDP_ACTION" in
 setup) exec bash "$PDP_SKILL_DIR/scripts/setup.sh" "$@" ;;
 build|verify|audit) exec node "$PDP_SKILL_DIR/scripts/$PDP_ACTION.mjs" "$@" ;;
 library-init|index|share-fonts)
  exec "$PDP_RUNTIME/venv/bin/python" "$PDP_SKILL_DIR/scripts/library.py" "$PDP_ACTION" "$@" ;;
 inspect|init|fonts|subset|register|compare|serve)
  if [ ! -x "$PDP_RUNTIME/venv/bin/python" ]; then echo 'Run pdp setup first.' >&2; exit 1; fi
  exec "$PDP_RUNTIME/venv/bin/python" "$PDP_SKILL_DIR/scripts/design.py" "$PDP_ACTION" "$@" ;;
 help|--help|-h) echo 'pdp setup | library-init | index | share-fonts | inspect | init | fonts | subset | register | build | audit | verify | compare | serve'
  echo 'All project commands take --project /output/directory. Use COMMAND --help for options.' ;;
 *) echo "Unknown command: $PDP_ACTION" >&2; exit 2 ;;
esac
